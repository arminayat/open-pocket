{
  "expo": {
    "name": "Open Pocket",
    "slug": "openpocket",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "openpocket",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nestorcodecrafters.openpocket",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Open Pocket uses Bluetooth to connect to your Pocket recorder and download your recordings.",
        "NSLocalNetworkUsageDescription": "Open Pocket connects directly to your Pocket recorder to download recordings over Wi-Fi."
      },
      "buildNumber": "6",
      "config": {
        "usesNonExemptEncryption": false
      },
      "appleTeamId": "G6WL4CPNV3"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "expo-dev-client",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "central"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "./plugins/with-pocket-wifi",
      "./plugins/with-ble-write-ready",
      "expo-asset",
      "./plugins/with-icloud",
      "./plugins/with-scene-lifecycle"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
