{
  "name": "openpocket",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "doctor": "expo-doctor",
    "check": "npm run typecheck && npm run lint && npm test && expo install --check",
    "export:ios": "expo export --platform ios",
    "ios:pods": "pod-install",
    "test:wifi-native": "xcrun swiftc -module-cache-path /private/tmp/openpocket-swift-module-cache modules/pocket-wifi/ios/PocketStreamDecoder.swift modules/pocket-wifi/tests/StreamDecoderChecks.swift -o /private/tmp/openpocket-wifi-decoder-checks && /private/tmp/openpocket-wifi-decoder-checks"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "base64-js": "^1.5.1",
    "expo": "~57.0.20",
    "expo-asset": "~57.0.19",
    "expo-audio": "~57.0.5",
    "expo-auth-session": "~57.0.14",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.12",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.3",
    "expo-image": "~57.0.4",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.9",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.1",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.21",
    "expo-web-browser": "~57.0.2",
    "heroui-native": "1.0.9",
    "lucide-react-native": "^1.41.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-ble-plx": "3.5.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "~4.3.3",
    "uniwind": "1.12.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "~19.2.18",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~57.0.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-plugin-react-native": "^5.0.0",
    "expo-doctor": "1.20.4",
    "metro": "0.84.5",
    "metro-cache": "0.84.5",
    "metro-transform-worker": "0.84.5",
    "pod-install": "1.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "tsx": "^4.20.6",
    "@types/node": "^22.0.0"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "packageManager": "npm@10.9.8",
  "private": true
}
