<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- TestFlight and the App Store require the sandbox. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The Pocket recorder. -->
	<key>com.apple.security.device.bluetooth</key>
	<true/>
	<!-- Recent dictations read OpenWhispr's history, read only. -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
	<array>
		<string>/Library/Application Support/open-whispr/</string>
	</array>
	<!-- Recordings read the iPhone app's iCloud Drive folder. The shared App ID has this container. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.nestorcodecrafters.openpocket</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.com.nestorcodecrafters.openpocket</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
	</array>
	<!-- Xcode's App Store export sets Production by itself (checked 2026-11-22); stated so the file matches the signed app. -->
	<key>com.apple.developer.icloud-container-environment</key>
	<string>Production</string>
</dict>
</plist>
